{
  "name": "dsh-codex-bridge",
  "version": "0.2.6",
  "description": "Codex 没有远程入口。把本机 Codex 会话接进 DSH 侧栏：按项目列出、点开读取、派发任务在后台续跑，并复用 DSH 登录连接，让已配对的手机也能操作，出门在外接着推进电脑上的任务",
  "type": "module",
  "license": "MIT",
  "author": "qwdqd-dwqd",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "codex-cli",
    "sidebar",
    "mobile"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "client.js",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwdqd-dwqd/dsh-codex-bridge.git"
  },
  "homepage": "https://github.com/qwdqd-dwqd/dsh-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/qwdqd-dwqd/dsh-codex-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
